---
import { getLangFromUrl, useTranslations } from '../../i18n';
import BoxIso from '../../Icons/BoxIso.astro';
import Community from '../../Icons/Community.astro';
import MagicWand from '../../Icons/MagicWand.astro';
import Sparks from '../../Icons/Sparks.astro';
import Throphy from '../../Icons/Throphy.astro';
import Cards from '../../components/Cards/Cards.astro';
import CardsItem from '../../components/Cards/CardsItem.astro';
import Link from '../../components/Link/Link.astro';
import './MainPage.css';

export interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<main class="main">
  <div class="content-wrapper main-page">
    <div class="block intro">
      <p class="intro__hi">{t('intro.hi')}</p>
      <h1 class="intro__name">{t('intro.name')}</h1>
    </div>
    <div class="block">
      <p>
        {t('intro.description')}
      </p>
    </div>
    <div class="block">
      <p class="block__description">
        {t('experience.description')}
      </p>
      <div class="block__content">
        <Cards as="ul" className="purge-ul" bentoCols={6}>
          <CardsItem
            as="li"
            bentoWidth={4}
          >
            <Throphy slot="icon" />
            <span slot="title">{t('card.scale.title')}</span>
            <span slot="description">
              {t('card.scale.description')}
              <Link href="https://www.etagi.com/" target="_blank">
                www.etagi.com
              </Link>
            </span>
          </CardsItem>
          <CardsItem as="li" bentoWidth={2}>
            <MagicWand slot="icon" />
            <span slot="title">{t('card.improvement.title')}</span>
            <span slot="description">
              {t('card.improvement.description')}
            </span>
          </CardsItem>
          <CardsItem as="li" bentoWidth={6}>
            <BoxIso slot="icon" />
            <span slot="title">{t('card.uikit.title')}</span>
            <span slot="description">
              {t('card.uikit.description_pre')}
              <Link href="https://storybook.etagi.com/" target="_blank">
                storybook.etagi.com
              </Link>
              {t('card.uikit.description')}
            </span>
          </CardsItem>
          <CardsItem as="li" bentoWidth={3}>
            <Sparks slot="icon" />
            <span slot="title">{t('card.development.title')}</span>
            <span slot="description">
              {t('card.development.description')}
            </span>
          </CardsItem>
          <CardsItem as="li" bentoWidth={3}>
            <Community slot="icon" />
            <span slot="title">{t('card.teamwork.title')}</span>
            <span slot="description">
              {t('card.teamwork.description')}
            </span>
          </CardsItem>
        </Cards>
      </div>
    </div>
    <div></div>
  </div>
</main>
